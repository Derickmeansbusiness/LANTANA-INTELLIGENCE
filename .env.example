# Supabase. Local values come from `pnpm supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by scripts and scheduled jobs, never in request paths.
SUPABASE_SECRET_KEY=

# Site URL used in auth emails (magic links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "switch test account" in the user menu. Local development only.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false

# Ask Lantana (Phase 4)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MODEL_BACKGROUND=claude-sonnet-5-5
